PORT=5000
# Dashboard login key — same value unlocks admin.html Site manager
ADMIN_KEY=admin123
# Get this free from https://cloud.mongodb.com (Create M0 free cluster → Connect → copy string)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
# Cloudinary (https://cloudinary.com → Dashboard) — all project uploads go here
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>
# Optional: only if frontend is hosted on a DIFFERENT domain (comma-separated).
# Same-service deploys (Render blueprint) leave this empty.
FRONTEND_URL=
